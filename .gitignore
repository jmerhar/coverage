# bin/test-coverage-report.py imports the engine by path, which caches bytecode next to it.
__pycache__/

# This repository's own coverage run: coverage.py's data files, and the report bin/test-all.sh and CI
# produce from them (see coverage.toml).
.coverage
.coverage.*
coverage/
coverage-upload/

# JUnit reports for Codecov's test analytics, written by bin/test-all.sh when $JUNIT_DIR is set.
junit/

# JetBrains IDE workspace.
.idea/
